SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
DATABASE_URL=postgresql+asyncpg://zima:password@localhost:5432/zimalab
API_HOST=0.0.0.0
API_PORT=8000
# Prefer a stable /dev/v4l/by-id/... symlink over a numeric index — plain
# /dev/videoN indices are not guaranteed to stay assigned to the same
# physical device across reboots or replugs. Find yours with:
#   ls -la /dev/v4l/by-id/
USB_CAM_DEVICE=/dev/v4l/by-id/usb-<vendor>_<model>-video-index0

KASA_HOST=192.168.1.x
KASA_USERNAME=your-tplink-account-email
KASA_PASSWORD=your-tplink-account-password
KASA_POLL_INTERVAL=10

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-token-here
INFLUX_ORG=zimalab
INFLUX_BUCKET=power
