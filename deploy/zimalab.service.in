[Unit]
Description=Zima Lab dashboard and API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@/rpi
ExecStart=@UV@ run uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

# Send Python output to journald immediately.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
